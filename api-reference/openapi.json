{
  "openapi": "3.1.0",
  "info": {
    "title": "Jumper API",
    "description": "LI.FI-compatible routing through Jumper's pipeline. Base path is `/pipeline/v1` on `api.jumper.xyz`. A successful `GET /quote` already returns a signable `transactionRequest`.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.jumper.xyz/pipeline/v1",
      "description": "Jumper production pipeline (LI.FI-compatible)"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/quote": {
      "get": {
        "summary": "Get best quote",
        "description": "Returns the best swap/bridge step for the requested amount. Response includes `transactionRequest` ready to sign and broadcast. Use integrator `jumper.exchange` (or your assigned integrator) and send the same value in `x-lifi-integrator`.",
        "parameters": [
          {
            "name": "fromChain",
            "in": "query",
            "required": true,
            "description": "Source chain ID (e.g. `42161` for Arbitrum).",
            "schema": {
              "type": "integer",
              "format": "int64",
              "example": 42161
            }
          },
          {
            "name": "toChain",
            "in": "query",
            "required": true,
            "description": "Destination chain ID.",
            "schema": {
              "type": "integer",
              "format": "int64",
              "example": 42161
            }
          },
          {
            "name": "fromToken",
            "in": "query",
            "required": true,
            "description": "Source token address. Use `0x0000000000000000000000000000000000000000` for the native asset.",
            "schema": {
              "type": "string",
              "example": "0xaf88d065e77c8cC2239327C5EDb3A432268e5831"
            }
          },
          {
            "name": "toToken",
            "in": "query",
            "required": true,
            "description": "Destination token address. Use `0x0000000000000000000000000000000000000000` for the native asset.",
            "schema": {
              "type": "string",
              "example": "0x0000000000000000000000000000000000000000"
            }
          },
          {
            "name": "fromAmount",
            "in": "query",
            "required": true,
            "description": "Amount in the smallest unit of `fromToken` (e.g. USDC 6 decimals: `1000000` = 1 USDC).",
            "schema": {
              "type": "string",
              "example": "1000000"
            }
          },
          {
            "name": "fromAddress",
            "in": "query",
            "required": true,
            "description": "Sender wallet that will sign and broadcast the transaction.",
            "schema": {
              "type": "string",
              "example": "0xcD82e0De2bB7c310D2800c400a82295785923618"
            }
          },
          {
            "name": "toAddress",
            "in": "query",
            "required": false,
            "description": "Recipient address. Defaults to `fromAddress` when omitted.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "order",
            "in": "query",
            "required": false,
            "description": "Route preference.",
            "schema": {
              "type": "string",
              "enum": ["CHEAPEST", "FASTEST", "SAFEST"],
              "default": "CHEAPEST",
              "example": "CHEAPEST"
            }
          },
          {
            "name": "slippage",
            "in": "query",
            "required": false,
            "description": "Max slippage as a fraction (e.g. `0.005` = 0.5%).",
            "schema": {
              "type": "number",
              "format": "double",
              "example": 0.005
            }
          },
          {
            "name": "integrator",
            "in": "query",
            "required": false,
            "description": "Integrator id for analytics and fee attribution. Jumper app uses `jumper.exchange`.",
            "schema": {
              "type": "string",
              "example": "jumper.exchange"
            }
          },
          {
            "name": "x-lifi-integrator",
            "in": "header",
            "required": false,
            "description": "Same integrator id as the `integrator` query param.",
            "schema": {
              "type": "string",
              "example": "jumper.exchange"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Quote step including a signable transaction",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuoteResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or no route",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown path (wrong base URL — use `/pipeline/v1`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/status": {
      "get": {
        "summary": "Get transfer status",
        "description": "Track a broadcast transfer by source transaction hash. LI.FI-compatible status query.",
        "parameters": [
          {
            "name": "txHash",
            "in": "query",
            "required": true,
            "description": "Source-chain transaction hash from the broadcast of `transactionRequest`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fromChain",
            "in": "query",
            "required": true,
            "description": "Source chain ID.",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "toChain",
            "in": "query",
            "required": true,
            "description": "Destination chain ID.",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "bridge",
            "in": "query",
            "required": false,
            "description": "Bridge/DEX tool from the quote (`tool` field), when known.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "integrator",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "example": "jumper.exchange"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Status response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            }
          },
          "404": {
            "description": "Transfer not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Token": {
        "type": "object",
        "properties": {
          "address": {
            "type": "string"
          },
          "chainId": {
            "type": "integer",
            "format": "int64"
          },
          "symbol": {
            "type": "string"
          },
          "decimals": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "priceUSD": {
            "type": "string"
          },
          "logoURI": {
            "type": "string"
          }
        },
        "required": ["address", "chainId", "symbol", "decimals"]
      },
      "TransactionRequest": {
        "type": "object",
        "description": "EVM transaction payload to sign and broadcast.",
        "properties": {
          "to": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "data": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "chainId": {
            "type": "integer",
            "format": "int64"
          },
          "gasLimit": {
            "type": "string"
          },
          "gasPrice": {
            "type": "string"
          }
        },
        "required": ["to", "data", "value", "chainId"]
      },
      "QuoteAction": {
        "type": "object",
        "properties": {
          "fromChainId": {
            "type": "integer",
            "format": "int64"
          },
          "toChainId": {
            "type": "integer",
            "format": "int64"
          },
          "fromAmount": {
            "type": "string"
          },
          "fromAddress": {
            "type": "string"
          },
          "toAddress": {
            "type": "string"
          },
          "slippage": {
            "type": "number",
            "format": "double"
          },
          "fromToken": {
            "$ref": "#/components/schemas/Token"
          },
          "toToken": {
            "$ref": "#/components/schemas/Token"
          }
        },
        "required": [
          "fromChainId",
          "toChainId",
          "fromAmount",
          "fromToken",
          "toToken"
        ]
      },
      "QuoteEstimate": {
        "type": "object",
        "properties": {
          "tool": {
            "type": "string"
          },
          "fromAmount": {
            "type": "string"
          },
          "toAmount": {
            "type": "string"
          },
          "toAmountMin": {
            "type": "string"
          },
          "approvalAddress": {
            "type": "string"
          },
          "executionDuration": {
            "type": "integer",
            "description": "Estimated seconds to completion."
          },
          "fromAmountUSD": {
            "type": "string"
          },
          "toAmountUSD": {
            "type": "string"
          }
        },
        "required": ["fromAmount", "toAmount", "toAmountMin"]
      },
      "QuoteResponse": {
        "type": "object",
        "description": "LI.FI step returned by Jumper pipeline quote.",
        "properties": {
          "type": {
            "type": "string",
            "example": "lifi"
          },
          "id": {
            "type": "string",
            "description": "Quote/step id."
          },
          "tool": {
            "type": "string",
            "description": "Bridge or DEX that will execute the step.",
            "example": "sushiswap"
          },
          "integrator": {
            "type": "string",
            "example": "jumper.exchange"
          },
          "action": {
            "$ref": "#/components/schemas/QuoteAction"
          },
          "estimate": {
            "$ref": "#/components/schemas/QuoteEstimate"
          },
          "transactionRequest": {
            "$ref": "#/components/schemas/TransactionRequest"
          },
          "transactionId": {
            "type": "string"
          },
          "includedSteps": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
        "required": [
          "id",
          "tool",
          "action",
          "estimate",
          "transactionRequest"
        ]
      },
      "StatusResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["NOT_FOUND", "INVALID", "PENDING", "DONE", "FAILED"]
          },
          "substatus": {
            "type": "string"
          },
          "sending": {
            "type": "object",
            "additionalProperties": true
          },
          "receiving": {
            "type": "object",
            "additionalProperties": true
          },
          "tool": {
            "type": "string"
          },
          "transactionId": {
            "type": "string"
          }
        },
        "required": ["status"]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "code": {
            "type": ["integer", "string"]
          }
        }
      }
    },
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
        "description": "Optional. Requests without a key are more aggressively rate limited."
      }
    }
  }
}
